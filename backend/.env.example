# RootIQ Backend Configuration
APP_NAME="RootIQ API"
APP_VERSION="1.0.0"
DEBUG=false
DATABASE_URL="postgresql+psycopg://postgres:postgres_password@localhost:5432/rootiq_db"
FRONTEND_URL="http://localhost:5173"

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT=30
