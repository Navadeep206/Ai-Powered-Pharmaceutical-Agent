# ==============================================================================
# RootIQ - Environment Configuration Blueprint (.env.example)
# Pharmaceutical API Manufacturing RCA & CAPA Intelligence Platform
# ==============================================================================
# NOTE: Copy this file to '.env' and fill in actual credentials in your local
# secure environment. NEVER commit actual keys, tokens, or credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME=RootIQ
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Server Host and Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rootiq_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_placeholder
# Asynchronous SQLAlchemy connection string
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. GROQ & LLM REASONING ENGINE
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_placeholder_replace_with_actual_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=4096

# ------------------------------------------------------------------------------
# 4. LANGGRAPH / LANGCHAIN AGENT ORCHESTRATION & OBSERVABILITY
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_placeholder_replace_with_langsmith_key
LANGCHAIN_PROJECT=rootiq-pharma-rca

# ------------------------------------------------------------------------------
# 5. GXP COMPLIANCE & 21 CFR PART 11 AUDIT SETTINGS
# ------------------------------------------------------------------------------
GXP_AUDIT_LOG_ENABLED=true
SYSTEM_TIMEZONE=UTC
ELECTRONIC_SIGNATURE_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# 6. CORS & NETWORKING
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 7. FRONTEND ENVIRONMENT CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
VITE_APP_NAME=RootIQ
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development

